; SAP Business One Service Layer (same TEST database as Testing/test_sap.py)
[sap_order_sync]
base_url = https://hanabtrust:50000/b1s/v1
company_db = UPDATEROW_TEST_BTRUST
username = manager
password = 258258
verify_ssl = false
timeout_seconds = 30
; Store the synchronization external key in the standard SAP NumAtCard field.
external_key_field = NumAtCard
; Actual Odoo product field containing SAP ItemCode.
odoo_product_itemcode_field = default_code
; Optional: Odoo stock.warehouse field containing SAP WarehouseCode.
odoo_warehouse_code_field =
; Optional fixed SAP warehouse (used only when no warehouse mapping field is set).
warehouse_code = Main

